          "stringUnit": {
            "state": "translated",
            "value": "The game is in progress"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego está en curso"
          }
        }
      }
    },
    "game.start.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(month)@ %2$(date)@ at %3$(time)@"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$(date)@ de %1$(month)@ a las %3$(time)@"
          }
        }
      }
    },
