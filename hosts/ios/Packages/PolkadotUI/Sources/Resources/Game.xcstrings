{
  "sourceLanguage": "en",
  "strings": {
    "deposit.required.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposit %@"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Depositar %@"
          }
        }
      }
    },
    "deposit.required.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposited funds will be held from you dollar account and sent back after you become a Member."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fondos depositados se retendrán de tu cuenta en dólares y se devolverán después de que te vuelvas Miembro."
          }
        }
      }
    },
    "deposit.required.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deposit is required"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un depósito"
          }
        }
      }
    },
    "deposit.required.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposit %@ to register and for the weekly games"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Deposita %@ para registrarte y para los juegos semanales"
          }
        }
      }
    },
    "game.in.progress": {
      "extractionState": "manual",
      "localizations": {
