    "chat.preview.game.announced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next game: %1$(time)@. Register now!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximo juego: %1$(time)@. ¡Regístrate ya!"
          }
        }
      }
    },
    "chat.preview.game.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You missed or failed the game. Play %1$(gamesLeft)lld more to get your membership"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Te perdiste el juego o no lo aprobaste. Juega %1$(gamesLeft)lld más para obtener tu membresía"
          }
        }
      }
    },
    "chat.preview.game.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game finished. Results may take a little while to process."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego terminó. Los resultados pueden tardar un poco en procesarse."
          }
        }
      }
    },
    "chat.preview.game.peer.reached": {
      "extractionState": "manual",
      "localizations": {
