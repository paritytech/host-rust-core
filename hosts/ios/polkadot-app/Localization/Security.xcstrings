    "jailbreakDetected.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has been jailbroken and is not safe to use. Please use this app on a non-jailbroken device."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo tiene jailbreak y no es seguro para usarse. Usa esta app en un dispositivo sin jailbreak."
          }
        }
      }
    },
    "jailbreakDetected.title": {
