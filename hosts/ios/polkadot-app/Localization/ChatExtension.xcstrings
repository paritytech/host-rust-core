          }
        }
      }
    },
    "mob.rule.proof.of.ink.details": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "· Is the Tattoo Design matches the submitted image in terms of design? \n· Are marks of skin reaction to the tattoo visible in the video to ensure that the process is real?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "· ¿El diseño del tatuaje coincide con la imagen enviada? \n· ¿Se ven en el video las marcas de reacción de la piel al tatuaje para confirmar que el proceso es real?"
          }
        }
      }
    },
    "mob.rule.true": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "✅ True"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "✅ Verdadero"
          }
        }
      }
    },
    "mob.rule.video.case": {
