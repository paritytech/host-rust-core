    "mob.rule.no.available.cases": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for contributing your judgments. You’ve completed all available cases. The app will notify you when new cases appear."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por aportar tus veredictos. Ya completaste todos los casos disponibles. La app te avisará cuando aparezcan casos nuevos."
          }
        }
      }
    },
    "mob.rule.photo.case": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tattoo Photo"
