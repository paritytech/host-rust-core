    "dim1.faq.question.how": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Should I Film the Evidence?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo debo grabar la evidencia?"
          }
        }
      }
    },
    "dim1.faq.question.location": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can I alter the location?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Puedo cambiar la ubicación?"
          }
        }
      }
    },
    "dim1.faq.question.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens after I submit the evidence?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué pasa después de enviar la evidencia?"
          }
        }
      }
    },
    "dim1.switch.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel your game progress and apply using a Unique Membership Tattoo instead?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar tu progreso en el juego y postularte con un Tatuaje de Membresía Único?"
          }
        }
      }
    },
    "dim1.switch.confirmation.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to the Unique Membership Tattoo Option?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar a la opción de Tatuaje de Membresía Único?"
          }
        }
      }
    },
    "dim1.switch.error.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit will be available after the active game you are participating in is finished"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás editar cuando termine el juego activo en el que participas"
          }
        }
      }
    },
    "dim1.welcome1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Become a Member by Getting a Unique Free Tattoo**\n\n✍️ Get Inked with Any Artist You Like and Provide a 3 Minute Video Documenting the Tattoo Process"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vuélvete Miembro con un tatuaje único y gratis**\n\n✍️ Tatúate con el artista que quieras y entrega un video de 3 minutos que documente el proceso"
          }
        }
      }
    },
    "dim1.welcome2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "📐 **Size.** This tattoo is available in several sizes ranging from 25 to 50 millimeters. You will see stencil with all sizes after booking.\n\n💪 **Tattoo Location.** The tattoo has to be made on inner part of the upper left arm. Centred between armpit and elbow."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "📐 **Tamaño.** Este tatuaje está disponible en varios tamaños, de 25 a 50 milímetros. Verás la plantilla con todos los tamaños después de reservar.\n\n💪 **Ubicación del tatuaje.** El tatuaje debe hacerse en la parte interna del brazo izquierdo, arriba. Centrado entre la axila y el codo."
          }
        }
      }
    },
    "dim1.welcome3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🎨 **Design.** Add a small $10 deposit to select your unique design from over 2,000 options available."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "🎨 **Diseño.** Agrega un depósito de $10 para elegir tu diseño único entre más de 2,000 opciones disponibles."
          }
        }
      }
    },
    "dim1.welcome4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "📆 **Execution.** Find any tattooer you like. You will also see a few suggested tattoo studios after booking."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "📆 **Ejecución.** Busca al tatuador que quieras. También verás algunos estudios de tatuaje sugeridos después de reservar."
          }
        }
      }
    },
    "dim1.welcome5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🤳 **Evidence.** Provide 3-minute proof of documentation video and a picture of the final tattoo"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "🤳 **Evidencia.** Entrega un video de documentación de 3 minutos y una foto del tatuaje final"
          }
        }
      }
    },
    "dim1.welcome6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "🗳️ **Review.** Tattoo Evidence is reviewed by other Polkadot peers, who will vote individually based on your documentation video evidence.\n\n💸 **Reimbursement.** Get Your Tattoo Expenses Refund"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "🗳️ **Revisión.** Otros peers de Polkadot revisan la evidencia del tatuaje y votan de forma individual con base en tu video de documentación.\n\n💸 **Reembolso.** Recupera lo que gastaste en tu tatuaje"
          }
        }
      }
    },
    "dim2.switch.confirmation.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel your reserved tattoo and register to start playing weekly games instead?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cancelar tu tatuaje reservado y registrarte para empezar a jugar los juegos semanales?"
          }
        }
      }
    },
    "dim2.switch.confirmation.title": {
      "extractionState": "manual",
      "localizations": {
