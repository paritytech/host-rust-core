          }
        }
      }
    },
    "dim2.switch.error.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching is not available after committing to a tattoo design"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes cambiar después de comprometerte con un diseño de tatuaje"
          }
        }
      }
    },
