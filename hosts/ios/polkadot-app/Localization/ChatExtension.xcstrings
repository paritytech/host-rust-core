{
  "sourceLanguage": "en",
  "strings": {
    "action.open.mobRules.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn by reviewing tattoo documentation videos"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana revisando videos de documentación de tatuajes"
          }
        }
      }
    },
    "action.open.weeklyGame.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect with new Members"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta con nuevos Miembros"
          }
        }
      }
    },
    "chat.title.dim1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
