    "commit.busy.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many ongoing judgements. Please, try again later"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay demasiados veredictos en curso. Inténtalo de nuevo más tarde"
