    "confirm.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be sure you’re happy with your choice, as the tattoo design can’t be changed after confirmation."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de estar conforme con tu elección, ya que el diseño del tatuaje no se puede cambiar después de confirmar."
          }
        }
      }
    },
