    "list.personal.families.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Procedural designs based on a your unique citizenship number or account address. The designs use algorithmic rules to map the input (e.g., a number or address) into specific aesthetic designs, ensuring both uniqueness and relevance to your individual data."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseños procedurales basados en tu número único de ciudadanía o en la dirección de tu cuenta. Los diseños usan reglas algorítmicas para convertir el dato de entrada (por ejemplo, un número o una dirección) en diseños estéticos específicos, garantizando que sean únicos y relevantes para tus datos personales."
          }
        }
      }
    },
    "list.personal.families.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
