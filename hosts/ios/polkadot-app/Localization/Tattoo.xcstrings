    "sendInquiry.defaultMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I hope this message finds you well. I've been admiring your work for a while now, and I'm interested in getting a custom tattoo from you.\n\nI have a specific design  that I'd like to have placed on inner part of the upper left arm.\n\nAdditionally, I would like to document the last three minutes of the tattooing process.\n\nCould we possibly schedule a consultation to discuss the design, placement, and the filming aspect?\n\nI'm attaching PDF with more information and details regarding the Tattoo Stencil, Placement, and Evidence video.\n\nLooking forward to the possibility of working with you."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Espero que estés muy bien. He admirado tu trabajo desde hace tiempo y me interesa hacerme un tatuaje personalizado contigo.\n\nTengo un diseño específico  que me gustaría colocar en la parte interna del brazo izquierdo, arriba.\n\nAdemás, me gustaría documentar los últimos tres minutos del proceso del tatuaje.\n\n¿Podríamos agendar una consulta para platicar sobre el diseño, la ubicación y la parte de la grabación?\n\nTe adjunto un PDF con más información y detalles sobre la plantilla del tatuaje, la ubicación y el video de evidencia.\n\nOjalá podamos trabajar juntos."
          }
        }
      }
    },
    "sendInquiry.pdfTitle": {
      "extractionState": "manual",
