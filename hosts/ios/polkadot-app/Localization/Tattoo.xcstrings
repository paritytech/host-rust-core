    "evidence.lowBattery.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone's battery must be at least 50% charged to record evidence. Otherwise, the recording session may be interrupted if your phone shuts down."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La batería de tu teléfono debe estar cargada al menos al 50% para grabar la evidencia. De lo contrario, la sesión de grabación podría interrumpirse si tu teléfono se apaga."
          }
        }
      }
    },
    "evidence.lowBattery.title": {
      "extractionState": "manual",
