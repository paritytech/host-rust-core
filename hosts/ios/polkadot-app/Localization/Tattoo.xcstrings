          }
        }
      }
    },
    "list.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the design\nfor your tattoo"
          }
        },
        "es-ES": {
