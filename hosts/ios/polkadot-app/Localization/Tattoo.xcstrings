    "discard.photo.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leaving now will lose the filmed photo evidence. If you want to re-take your photo proceed with discard option."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si sales ahora perderás la evidencia fotográfica tomada. Si quieres volver a tomar la foto, continúa con la opción de descartar."
          }
        }
      }
    },
    "discard.photo.title": {
      "extractionState": "manual",
