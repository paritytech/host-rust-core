    "appFactoryReset.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It looks like the app environment was updated and your account no longer exists on-chain. You'll need to start fresh."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que el entorno de la app se actualizó y tu cuenta ya no existe en la red. Tendrás que empezar de nuevo."
          }
        }
      }
    },
