        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Provide Judgments, Earn Rewards**\n· The app will send you documentation  tattoo videos and photos\n· Provide ✅ True or ❌ False  judgement for each case, earn  rewards for each statement"
          }
        },
