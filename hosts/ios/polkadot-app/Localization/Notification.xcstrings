    "game.notification.game.start.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game is starting! Jump in!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El juego está por comenzar! ¡Entra!"
          }
        }
      }
    },
    "game.notification.game.start.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Starts in %@ Seconds!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El juego comienza en %@ segundos!"
          }
        }
      }
    },
    "game.notification.registration.start.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game starts in %ld min! Join for free to win amazing prizes!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El juego comienza en %ld min! Únete gratis y gana premios increíbles."
          }
        }
      }
    },
    "game.notification.registration.start.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the %@ game"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete al juego de %@"
          }
        }
      }
    },
    "game.notification.registration.closing.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register now – prizes and collectibles await!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Regístrate ahora: ¡te esperan premios y coleccionables!"
          }
        }
      }
    },
    "game.notification.registration.closing.title": {
      "extractionState": "manual",
