{
  "sourceLanguage": "en",
  "strings": {
    "discardNotifications.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disabling notifications may result in missing important updates, actions that need to be taken, and could overall prolong the evidence upload and review process."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar las notificaciones puede hacer que te pierdas novedades importantes y acciones que debes realizar, y podría alargar el proceso de carga y revisión de la evidencia."
          }
        }
      }
    },
    "discardNotifications.game.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing games will result in losing your Membership."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Perderte los juegos hará que pierdas tu Membresía."
          }
        }
      }
    },
    "discardNotifications.game.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We strongly recommend enabling notifications to avoid missing games"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recomendamos activar las notificaciones para no perderte ningún juego"
          }
        }
      }
    },
    "discardNotifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We kindly recommend enabling notifications to avoid missing important updates about your evidence processing"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recomendamos activar las notificaciones para no perderte novedades importantes sobre el procesamiento de tu evidencia"
          }
        }
      }
    },
    "enableNotification.denied.game.additionalInfo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay informed: Notifications are currently turned off. You can enable them in Settings to avoid missing games and losing your Membership."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantente al tanto: las notificaciones están desactivadas. Puedes activarlas en Configuración para no perderte juegos ni tu Membresía."
          }
        }
      }
    },
    "enableNotification.denied.game.additionalInfoHighlighted": {
      "extractionState": "manual",
      "localizations": {
