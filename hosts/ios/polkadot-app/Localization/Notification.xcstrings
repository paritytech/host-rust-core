    "game.notification.waiting.room.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game is about to start! Join and get ready for fun and rewards!"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "¡El juego está por comenzar! Únete y prepárate para divertirte y ganar recompensas."
