    "send.all.warning.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This transaction will cause %@ to be lost. If your balance falls below the minimum of %@, any remaining tokens will be forfeited"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción provocará la pérdida de %@. Si tu saldo cae por debajo del mínimo de %@, los tokens restantes se perderán"
          }
        }
      }
    },
