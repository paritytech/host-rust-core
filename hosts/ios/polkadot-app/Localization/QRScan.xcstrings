  "strings": {
    "error.camera.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfortunately, access to the camera is restricted."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentablemente, el acceso a la cámara está restringido."
          }
        }
      }
    },
    "error.camera.restricted_previously": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unfortunately, you denied access to camera previously. Would you like to allow access now?"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Lamentablemente, negaste el acceso a la cámara anteriormente. ¿Quieres permitir el acceso ahora?"
          }
        }
      }
    },
    "error.camera.title": {
      "extractionState": "manual",
      "localizations": {
