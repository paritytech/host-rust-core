    "signVrf.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will generate cryptographic randomness for %1$(transcriptLabel)@ purpose that %2$(productId)@ can verify. It cannot move your assets or grant spending permission."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto generará aleatoriedad criptográfica con el propósito de %1$(transcriptLabel)@ que %2$(productId)@ puede verificar. No puede mover tus activos ni otorgar permiso de gasto."
          }
        }
      }
    },
