{
  "sourceLanguage": "en",
  "strings": {
    "%@ ≈ %@": {
      "comment": "A value showing the exchange rate between two currencies. The first argument is the first currency code. The second argument is the second currency code.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ ≈ %2$@"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ≈ %2$@"
          }
        }
      }
    },
    "≈ %@": {
      "comment": "A label displaying the fee amount.",
      "localizations": {
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "≈ %@"
          }
        }
      }
    },
