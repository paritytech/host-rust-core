    "addToCalendar.game.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never miss a game, the app will remind you before the game starts"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "No te pierdas ningún juego: la app te recordará antes de que comience"
