    "game.camera.permission.registration.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is required to play the game. You can enable it in iOS Settings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso a la cámara para jugar. Puedes activarlo en la Configuración de iOS."
          }
        }
      }
    },
    "game.camera.permission.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera Access Required"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso a la cámara"
          }
        }
      }
    },
    "game.camera.permission.video.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video is unavailable because camera access is disabled. You can enable it in iOS Settings."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El video no está disponible porque el acceso a la cámara está desactivado. Puedes activarlo en la Configuración de iOS."
          }
        }
      }
    },
    "game.confirmRegistration.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once confirmed, participation is required. Missing this game risks deposit loss."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez confirmado, tu participación es obligatoria. Si te pierdes este juego, corres el riesgo de perder el depósito."
          }
        }
      }
    },
    "game.confirmRegistration.title": {
      "extractionState": "manual",
