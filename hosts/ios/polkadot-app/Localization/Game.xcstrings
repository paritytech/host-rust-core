    "game.info.footer.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don't want to play games for Membership, quit anytime and apply with a tattoo and video evidence."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no quieres jugar para obtener la Membresía, puedes salir cuando quieras y postularte con un tatuaje y evidencia en video."
          }
        }
      }
