          }
        }
      }
    },
    "balance.info.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See what makes up your balance"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta cómo se compone tu saldo"
          }
        }
      }
    },
    "balance.info.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
