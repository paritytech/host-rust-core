          }
        }
      }
    },
    "privacy.cost.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra %@ is spendable, but at the risk of reducing your privacy"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden gastar %@ más, pero con el riesgo de reducir tu privacidad"
          }
        }
      }
    },
    "privacy.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This payment might reduce your privacy"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pago podría reducir tu privacidad"
          }
        }
      }
    },
    "privacy.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this payment you are using funds that have not yet been fully processed by the privacy system."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "En este pago estás usando fondos que aún no han sido completamente procesados por el sistema de privacidad."
          }
        }
      }
    },
    "privacy.confirm.send.anyway": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send %@ anyway"
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar %@ de todos modos"
          }
        }
      }
    }
  },
  "version": "1.1"
}
