{
  "name": "@parity/truapi-dev-host",
  "version": "0.1.0",
  "description": "Local development signing host for TrUAPI products: runs the native truapi-host CLI as an npm dev dependency, with a process supervisor, network presets, and a browser bridge. For the embeddable WASM host runtime see @parity/truapi-host.",
  "license": "MIT",
  "author": "Parity Technologies <admin@parity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/host-rust-core.git",
    "directory": "js/packages/truapi-dev-host"
  },
  "homepage": "https://github.com/paritytech/host-rust-core#readme",
  "bugs": {
    "url": "https://github.com/paritytech/host-rust-core/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "truapi-host": "bin/truapi-host.mjs",
    "truapi-dev-host": "bin/truapi-dev-host.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "npm run build",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@parity/truapi": "^0.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22",
    "typescript": "^5.7"
  }
}
