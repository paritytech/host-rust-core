{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@parity/truapi": ["../../../../js/packages/truapi/src/index.ts"]
    }
  },
  "include": [
    "runner.ts",
    "browser-bootstrap.ts",
    "browser-assets.ts",
    "sandbox-*.ts",
    "../../../../scripts/build-cli-runner.ts",
    "../../../../scripts/cli-runner-package.test.ts"
  ]
}
